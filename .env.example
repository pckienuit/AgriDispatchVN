# Local development only. Never reuse these sample credentials in cloud.
PORT=3000
APP_PORT=3000
PG_PORT=5433
POSTGRES_DB=agridispatch
POSTGRES_USER=agridispatch
POSTGRES_PASSWORD=local_dev_only
DATABASE_URL=postgresql://agridispatch:local_dev_only@127.0.0.1:5433/agridispatch
# Dedicated disposable *_test DB only; integration tests destroy public schema.
TEST_DATABASE_URL=postgresql://agridispatch:disposable_test_only@127.0.0.1:5434/agridispatch_test
